# ==============================================================================
# MSR NEXT GEN TRACKER & MAYA AGI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. GROQ API (Free Tier - Llama 3.3 70B & 8B)
# Get your free key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. OPENROUTER API (Free Tier Models: Llama 3.3, DeepSeek R1 Free, Gemini Flash)
# Get free key at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-your_openrouter_free_key_here

# 3. SUPABASE DATABASE (Free Tier Postgres)
# Create a free project at: https://supabase.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 4. FIREBASE AUTHENTICATION (Phone OTP Login)
# Create a free Firebase project at: https://console.firebase.google.com
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=msr-next-gen.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=msr-next-gen
VITE_FIREBASE_STORAGE_BUCKET=msr-next-gen.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef

# 5. FUTURE MAYA AGI CENTRAL INTELLIGENCE BRIDGE (Optional)
VITE_MAYA_AGI_ENDPOINT=https://maya-agi-hub.yourdomain.com
VITE_MAYA_AGI_KEY=maya_agi_secret_token_123

# 6. E-COMMERCE & LOGISTICS (For Supabase Edge Functions)
SHOPIFY_STORE_URL=amparolife.myshopify.com
SHOPIFY_ADMIN_API_KEY=shpat_...
